# Supply chain hardening for the plugin's own dependencies (yarn 1).
# yarn reads this file from the current directory and its parents, so it also
# covers installs in subdirectories such as build/kibana/searchguard.
#
# Never run lifecycle scripts (preinstall/install/postinstall) of dependencies.
# None of the plugin's dependencies needs one. `yarn run <script>` is unaffected.
ignore-scripts true

# A plain `yarn install` must match yarn.lock exactly and fails otherwise.
# `yarn add` and `yarn upgrade` still update the lockfile.
--install.frozen-lockfile true
